{
  "expo": {
    "name": "MiniMe Lab",
    "slug": "logan98",
    "scheme": "minimelab",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.minimelab.companion",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 2,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.minimelab.companion",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f3587d31-352c-4b6d-9491-d9352b9e122e"
      }
    }
  }
}
